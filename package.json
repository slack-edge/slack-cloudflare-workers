{
  "name": "slack-cloudflare-workers",
  "version": "1.3.10",
  "description": "Slack app development framework for Cloudflare Workers",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:clean": "rm -rf ./dist && tsc",
    "format": "npx @biomejs/biome format --write src/ examples/simple-app/src/ examples/oauth-app/src/",
    "lint": "knip",
    "prepublishOnly": "npm run build:clean"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slack-edge/slack-cloudflare-workers.git"
  },
  "keywords": [
    "Slack",
    "ChatBot",
    "TypeScript",
    "Cloudflare",
    "Cloudflare Workers",
    "Serverless"
  ],
  "author": "Kazuhiro Sera",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/slack-edge/slack-cloudflare-workers/issues"
  },
  "homepage": "https://github.com/slack-edge/slack-cloudflare-workers#readme",
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "slack-edge": "^1.3.14",
    "slack-web-api-client": "^1.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "knip": "^6.13.1",
    "typescript": "^5.9.3"
  }
}
